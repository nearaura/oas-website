{
	"name": "oas-website",
	"compatibility_date": "2026-11-21",
	"main": "./worker/index.ts",
	"vars": {
		"BACKEND_ORIGIN": "https://launches-tourism-entrepreneur-contributing.trycloudflare.com"
	},
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/tina/*", "/tina-island/*"]
	},
	"observability": {
		"enabled": true
	}
}
