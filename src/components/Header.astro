---
import config from "virtual:starlight/user-config";
import { logos } from "virtual:starlight/user-images";
import Search from "@six-tech/starlight-theme-six/overrides/Search.astro";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import ThemeSelect from "@six-tech/starlight-theme-six/overrides/ThemeSelect.astro";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
const pathname = Astro.url.pathname;
const isUserManual =
  pathname === "/user-manual" || pathname.startsWith("/user-manual/");
const isDevelopment =
  pathname === "/development" || pathname.startsWith("/development/");
---

<div class="header-left">
  <a href="/" class="site-title">
    <img
      class="logo-size"
      alt={config.logo?.alt ?? "OnmyojiAutoScript"}
      src={logos.dark?.src}
      width={logos.dark?.width}
      height={logos.dark?.height}
    />
    <span class="title-text">OnmyojiAutoScript</span>
  </a>
  <div class="search-slot">{shouldRenderSearch && <Search />}</div>
</div>

<button class="show-modal" popovertargetaction="toggle" popovertarget="drawer">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M3.75 9h16.5m-16.5 6.75h16.5"
    ></path>
  </svg>
  <span class="sr-only">Toggle Menu</span>
</button>

<div class="header-right">
  <nav class="oas-nav" aria-label="主导航">
    <a
      href="/user-manual/getting-started/"
      aria-current={isUserManual ? "page" : undefined}
    >
      用户手册
    </a>
    <a
      href="/development/preamble/"
      aria-current={isDevelopment ? "page" : undefined}
    >
      开发文档
    </a>
    <a href="https://github.com/nearaura/OASX" rel="external">
      OASX
    </a>
  </nav>

  <nav class="header-nav">
    <div>
      <a
        href="/admin"
        class="sl-flex button edit-site-icon-link"
        data-variant="ghost"
        aria-label="编辑此站"
        title="编辑此站"
      >
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#f59e0b"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
        <span class="sr-only">编辑此站</span>
      </a>
    </div>
    <div>
      <a
        href="https://github.com/nearaura/OnmyojiAutoScript"
        rel="me"
        class="sl-flex button github-link"
        data-variant="ghost"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"></path>
        </svg>
        <span class="sr-only">GitHub</span>
      </a>
    </div>
    <div class="custom-social-links" aria-label="社交平台">
      <a
        href="https://t.me/"
        rel="me"
        class="sl-flex button"
        data-variant="ghost"
        aria-label="电报"
        title="电报"
      >
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24">
          <path
            fill="#26A5E4"
